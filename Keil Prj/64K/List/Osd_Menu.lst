 125          /***********************************************************
 126          *name:       FindComdInCurMenuItem(MSG curMsg)
 127          *input:      curMsg
 128          *output:     comd 
 129          *update:     2012-01-13
 130          *state:      allright
 131          
 132          *description:   
 133                     从当前的Item 找到相应的输入命令，并返回此命令值.(MSG -> COMD) 
 134          
 135          *history:
 136          ************************************************************/
 137          UCHAR FindComdInCurMenuItem(MSG curMsg)
 138          { 
 139   1          UCHAR XDATA ucComd = COMD_Nothing;  
 140   1          UCHAR XDATA ucIndex;
 141   1        
 142   1      #define CheckInputSource ((CurrentMenuItem.KeyComdMap[ucIndex].Source == g_sysSetting.Video.curSource)||(C
             -urrentMenuItem.KeyComdMap[ucIndex].Source == ALL_INPUT_SOURCE))
 143   1      
 144   1      FindComdAgain:
 145   1      
 146   1        for(ucIndex=0;ucIndex<CurrentMenuItem.ComdCount; ucIndex++)
 147   1        {   
 148   2            if((CurrentMenuItem.KeyComdMap[ucIndex].Msg == curMsg)&&CheckInputSource)
 149   2            {         
 150   3            if(CurrentMenuItem.KeyComdMap[ucIndex].cConditions & g_UserInputInfo.Status)
 151   3            {
 152   4              ucComd = CurrentMenuItem.KeyComdMap[ucIndex].Comd;  
 153   4              return ucComd;
 154   4            }
 155   3            else
 156   3            {
 157   4                return COMD_Nothing;  
 158   4            }
 159   3            }
 160   2        }
 161   1          /*表示此按键信息在当前菜单中无效，切换到根菜单*/
 162   1        if(FindMenuPageIndex(Osd_RootMenu) != g_ucMenuPageIndex)
 163   1        {       
 164   2          g_ucMenuPageIndex = FindMenuPageIndex(Osd_RootMenu);
 165   2          g_ucMenuItemIndex = 0; 
 166   2          goto FindComdAgain;
 167   2        }
 168   1        return COMD_Nothing;  
 169   1      }
