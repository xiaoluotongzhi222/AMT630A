 603          void DrawOsdTitel(TitelType *pTitel,UINT status)
 604          {
 605   1          UCHAR XDATA ucForeColor,ucBackColor;
 606   1        
 607   1          //printfStr("DrawOsdTitel");
C51 COMPILER V9.60.7.0   OSD_MENU                                                          03/25/2026 18:01:00 PAGE 11  

 608   1          while(1)
 609   1          {
 610   2               if(pTitel == NULL)
 611   2               {
 612   3                  break;
 613   3               }
 614   2           if(status&osdDraw)
 615   2           {
 616   3             ucForeColor = pTitel->ForeColor;
 617   3             ucBackColor = pTitel->BackColor;
 618   3           }
 619   2           if(status&osdSel)
 620   2           {
 621   3             ucForeColor = pTitel->SelForeColor;
 622   3             ucBackColor = pTitel->SelBackColor;
 623   3           }
 624   2           
 625   2            if(pTitel->DisplayText)
 626   2            {
 627   3                 OsdDrawStr(pTitel->XPos, pTitel->YPos,COLOR(ucForeColor,ucBackColor),pTitel->DisplayText());
 628   3            }
 629   2          if(pTitel->Flags & osdEnd)
 630   2          {
 631   3                break;
 632   3          }
 633   2          pTitel++;
 634   2          }
 635   1         
 636   1      }
