 154          BOOL AdjustReset(UCHAR opratComd)
 155          {    
 156   1      
 157   1              if((opratComd == COMD_IncValue) ||(opratComd == COMD_DecValue))
 158   1          {    
 159   2                      if(NORMAL == g_sysSetting.Reset.ResetVal)
 160   2              {
 161   3                 g_sysSetting.Reset.ResetVal = RESET;
 162   3              }
 163   2                      else if(RESET == g_sysSetting.Reset.ResetVal)
 164   2                      {
 165   3                         g_sysSetting.Reset.ResetVal = EXECT;
 166   3                      }
 167   2                      
 168   2                 //printf("AdjustReset Value = %d",g_sysSetting.Reset.ResetVal);
 169   2          }
 170   1              return 1;
 171   1      }
