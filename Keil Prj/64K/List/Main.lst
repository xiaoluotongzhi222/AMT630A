 359   3              }
 360   2              // =========================================================
 361   2      
 362   2              if(current_has_signal != last_has_signal)
 363   2              {
 364   3                  if(current_has_signal == 1)
 365   3                  {
 366   4                      SetVDETestSwitch(VDE_CLOSE); 
 367   4                  }
 368   3                  else
 369   3                  {
 370   4                      SetVDETestSwitch(VDE_BLACK); 
 371   4                  }
 372   3                  last_has_signal = current_has_signal;
 373   3              }
 374   2              is_alarm = (j < 2) ? 1 : 0; 
 375   2              if(is_alarm && blink == 0) 
 376   2              {
 377   3      
 378   3                  Update_Radar_Distance(j, i,0x01); 
 379   3                   Update_Radar_Logic(j, sim_angle, blink);
 380   3                    SetP0_4(1);
 381   3              }
 382   2              else 
 383   2              {
