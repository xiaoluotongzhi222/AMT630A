 385   3                    SetP0_4(0);
 386   3                  Update_Radar_Logic(j, sim_angle, blink);
 387   3              }
 388   2      
 389   2              DelayMs(100); 
 390   2      
 391   2              blink = !blink;
 392   2      
 393   2              time_slice++;
 394   2              if(time_slice >= 6)
 395   2              {
 396   3                  time_slice = 0;
 397   3      
 398   3                  i++;
 399   3                  if(i > 9) 
 400   3                  {
 401   4                    i = 0;
 402   4                    j++;
 403   4                    if(j>9)
 404   4                    {
 405   5                      j=0;
 406   5                    }
 407   4                  }
 408   3      
 409   3                  sim_angle += (angle_dir * 20);
 410   3                  if(sim_angle >= 60) {
 411   4                      sim_angle = 60;
 412   4                      angle_dir = -1; 
 413   4                  }
 414   3                  else if(sim_angle <= -60) {
 415   4                      sim_angle = -60;
 416   4                      angle_dir = 1; 
 417   4                  }
 418   3              }
