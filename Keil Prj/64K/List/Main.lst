 344   4                  }
 345   3              }
 346   2              else
 347   2              {
 348   3                 
 349   3                  signal_debounce_cnt = 0; 
 350   3              }
 351   2      
 352   2              if(signal_debounce_cnt >= 20)
 353   2              {
 354   3                  current_has_signal = 1;
 355   3              }
 356   2              else
 357   2              {
 358   3                  current_has_signal = 0;
