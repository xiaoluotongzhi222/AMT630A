 197   1      
 198   1          for(r = 0; r < 6; r++)
 199   1          {
 200   2      
 201   2              is_target_row = 0;
 202   2              
 203   2              if (dist_val > 6) 
 204   2              {
 205   3                  if (r == 0 || r == 5) is_target_row = 1;
 206   3              }
 207   2              else if (dist_val >= 2) 
 208   2              {
 209   3                  if (r == 1 || r == 4) is_target_row = 1;
