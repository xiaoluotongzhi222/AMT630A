 312          void main(void)                                                      
 313          {   
 314   1        UCHAR XDATA current_has_signal = 1; 
 315   1        UCHAR XDATA last_has_signal = 2;
 316   1        UCHAR XDATA signal_debounce_cnt = 0;
 317   1        UINT  i = 0;
