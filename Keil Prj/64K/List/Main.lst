 327   1        InitSystem();
 328   1      
 329   1        printfStr("<<<<<<<<<<<<<<  Welcom to ARK >>>>>>>>>>>>\n");
 330   1      
 331   1        MenuProcessKey(COMD_SelPowerOnMode);
 332   1        
 333   1        printfStr("<<<<<<<<<<<<<<  Enter main loop >>>>>>>>>>>>\n");  
 334   1        ShowRadarDemo(); 
 335   1          while(1) { 
 336   2              WDT_CLR = 0xbb; 
 337   2              WDT_CLR = 0x44;
