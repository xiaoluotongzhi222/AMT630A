 219   3      
 220   3                  is_target_seg = 0;
 221   3      
 222   3      
 223   3                  if (angle > 30 &&s == 0)
 224   3                  {
 225   4                    is_target_seg = 1;
 226   4                  }
 227   3                  else if(angle>0&&angle<=30&&s==1)
 228   3                  {
 229   4                    is_target_seg = 1;
 230   4                  }
