 136          void Radar_Set_Segment(UCHAR r, UCHAR s, UCHAR state)
 137          {
 138   1          UCHAR XDATA color;
 139   1          UCHAR XDATA screen_row;
 140   1      
 141   1      
 142   1          if(r > 5 || s > 3) return;
 143   1      
 144   1      
 145   1          if(r == 0 || r == 5)      color = COL_GREEN;
 146   1          else if(r == 2 || r == 3) color = COL_RED;
 147   1          else                      color = COL_YELLOW;
 148   1      
 149   1      
 150   1          if(state == 0)
 151   1          {
 152   2              color = 0x00; 
 153   2          }
 154   1      
 155   1          switch(r)
 156   1          {
 157   2      
 158   2              case 0: screen_row = 0; break; // F3 (Far)
 159   2              case 1: screen_row = 1; break; // F2
 160   2              case 2: screen_row = 2; break; // F1
 161   2      
 162   2      
 163   2              case 3: screen_row = 9;  break; // R1
 164   2              case 4: screen_row = 10; break; // R2
 165   2              case 5: screen_row = 11; break; // R3
 166   2          }
 167   1      
 168   1      
 169   1          Draw_Radar_Segment(r, s, color, screen_row, WAVE_START_COL);
 170   1      }
