 173          void Update_Radar_Logic(UCHAR dist_val, char angle, UCHAR blink_state)
 174          {
 175   1          UCHAR XDATA r, s;
 176   1          UCHAR XDATA is_target_row;
 177   1          UCHAR XDATA is_target_seg;
 178   1          
 179   1      
 180   1          for(r = 0; r < 6; r++)
 181   1          {
 182   2      
 183   2              is_target_row = 0;
 184   2              
 185   2              if (dist_val > 6) 
 186   2              {
 187   3                  if (r == 0 || r == 5) is_target_row = 1;
 188   3              }
 189   2              else if (dist_val >= 2) 
 190   2              {
 191   3                  if (r == 1 || r == 4) is_target_row = 1;
 192   3              }
 193   2              else 
 194   2              {
 195   3                  if (r == 2 || r == 3) is_target_row = 1;
 196   3              }
 197   2      
 198   2      
 199   2              for(s = 0; s < 4; s++)
 200   2              {
 201   3      
 202   3                  is_target_seg = 0;
 203   3      
 204   3      
 205   3                  if (angle > 30 &&s == 3)
 206   3                  {
 207   4                    is_target_seg = 1;
 208   4                  }
 209   3                  else if(angle>0&&angle<=30&&s==2)
 210   3                  {
 211   4                    is_target_seg = 1;
 212   4                  }
 213   3                  else if(angle<=0&&angle>=-30&&s==1)
 214   3                  {
 215   4                    is_target_seg = 1;
 216   4                  }
 217   3                  else if(angle<-30&&s==0)
 218   3                  {
 219   4                    is_target_seg = 1;
 220   4                  }
 221   3                  if (is_target_row && is_target_seg)
 222   3                  {
 223   4                      Radar_Set_Segment(r, s, blink_state);
 224   4                  }
 225   3                  else
 226   3                  {
 227   4                      Radar_Set_Segment(r, s, 1);
 228   4                  }
 229   3              }
 230   2          }
 231   1      }
