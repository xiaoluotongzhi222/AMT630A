              void InitalCpuPannel()
              {
                 UCHAR contWriteF0 = 0;
                 
                 //inital Cpu pannel reg      
                 InitalCPU_RM68130_16bit();
                 
                 //inital AMT Cpu Ram
                 WriteComdToF0(1,0x2A);
                 contWriteF0 = 0;
                 WriteDataToF0(0X00);
                 contWriteF0++;
                 WriteDataToF0(0X00);
                 contWriteF0++;  
                 WriteDataToF0(0X01);
                 contWriteF0++;
                 WriteDataToF0(0Xdf);
                 contWriteF0++;
                 WriteComdToF0(0,0X2B);
                 contWriteF0++;
                 WriteDataToF0(0X00);
                 contWriteF0++;
                 WriteDataToF0(0X00);
                 contWriteF0++;
                 WriteDataToF0(0X01);
                 contWriteF0++;
                 WriteDataToF0(0X3f);
                 contWriteF0++;
                 WriteComdToF0(0,0X2C);
                 contWriteF0++;
              
                 XBYTE[0XFD82] = (contWriteF0<<4) + 0x06; 
                 XBYTE[0XFD81] = (_BIT4 |_BIT2);//data_refresh_en、adr_clr_en    
                 XBYTE[0XFD83] |= _BIT0;   
              
                 //Set Cpu bit mode
                 SetCpuBitMode(_16BIT_RGB666);
              }
              #endif//RM68130_16BIT ==ENABLE
              
              
