              ULONG transfor18BitDate(UINT dat)
              {
                  ULONG tempDat = 0x00;
                      
                      #if CpuInitPannelMode == _18BIT_MODE
                      tempDat = (dat>>8)&0xff;
                      tempDat <<= 9;
                      tempDat |= dat & 0xff;
                      tempDat <<= 1;
                      #endif
              
                      #if CpuInitPannelMode == _16BIT_MODE
                      tempDat = (dat>>8)&0xff;
                      tempDat <<= 9;
                      tempDat |= dat & 0xff;
                      tempDat <<= 1;
                      #endif
                      
                      #if CpuInitPannelMode == _09BIT_MODE
                      tempDat = dat&0xff;
                      tempDat <<= 10;
                      #endif
              
                      #if CpuInitPannelMode == _08BIT_MODE
                      tempDat = dat&0xff;
C51 COMPILER V9.00   CPU                                                                   07/02/2013 14:00:51 PAGE 4   

                      tempDat <<= 10;
                      #endif
                      
                  return tempDat;
              }
              
              void CPU_Pannel_Reset(void)
              { 
                  printfStr("Set Cpu Pannel Reset");
                      
                  XBYTE[0XFD83] |= _BIT1;    //cpu reset 1
                      DelayMs(200);
                      
                  XBYTE[0XFD83] &= (~_BIT1); //cpu reset 0
                      DelayMs(200);
                      
                      XBYTE[0XFD83] |= _BIT1;    //cpu reset 1
                      DelayMs(200); 
              }
              
              
              void SetCpuSoftwareMode()
              {
                  printfStr("Set Cpu Pannel SoftwareMode");
                              
                  XBYTE[0XFD80] = 0XFF;
                      XBYTE[0XFD81] |= (_BIT0); 
              }
              
              void SetCpuHardwareMode()
              {
                      XBYTE[0XFD81] &= (~_BIT0); 
              }
                              
              
              void WriteComdToF0(BOOL bStart,UINT comd)
              {
                  ULONG tmpDat;
                      
                      tmpDat = transfor18BitDate(comd);
                      tmpDat &=( ~_BIT18);
                  if(bStart)
                  {
                      tmpDat |= _BIT19;
                  }
                  else
                  {
                      tmpDat &= (~_BIT19);
                  }   
                      XBYTE[0XFDF0] = (UCHAR)((tmpDat>>16) & 0xff);
                  XBYTE[0XFDF0] = (UCHAR)((tmpDat>>8) & 0xff);        
                      XBYTE[0XFDF0] = (UCHAR)(tmpDat & 0xff);
              }
              
              void WriteDataToF0(UINT dat)
              {
                  ULONG tmpDat;
                      
                      tmpDat = transfor18BitDate(dat);
                      tmpDat |=(_BIT18);
                  tmpDat &= (~_BIT19);
                  XBYTE[0XFDF0] = (UCHAR)((tmpDat>>16) & 0xff);
C51 COMPILER V9.00   CPU                                                                   07/02/2013 14:00:51 PAGE 5   

                  XBYTE[0XFDF0] = (UCHAR)((tmpDat>>8) & 0xff);        
                      XBYTE[0XFDF0] = (UCHAR)(tmpDat & 0xff);
              }
              
              void SetCpuBitMode(UCHAR Mode)
              {
                 if(_18BIT_RGB666 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= _BIT5; 
                 }
                 if(_16BIT_RGB666 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= _BIT5; 
                 }
                 if(_16BIT_RGB656 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= _BIT5; 
                 }
                 if(_09BIT_RGB666 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= _BIT6; 
                 }
                 if(_08BIT_RGB656 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= (_BIT6|_BIT5); 
                 }
                 if(_08BIT_RGB666 == Mode)
                 {
                         XBYTE[0XFD81] &= ~(_BIT7|_BIT6|_BIT5); 
                         XBYTE[0XFD81] |= _BIT7; 
                 }
              }
              
              
              
              void WriteCpuCmd(UINT Val)
              {
                  ULONG tmpDat;
                      tmpDat = transfor18BitDate(Val); 
              
                  #if CpuInitWrSignalMode == NORMAL_MODE_WR
                      tmpDat &=( WR_0);
                      #endif
                      
                      #if CpuInitWrSignalMode == _7414_MODE_WR
                      tmpDat |=( WR_1);
                      #endif
                      
                      tmpDat |=( RD_1);
                      tmpDat &=( CS_0);
                      tmpDat &=( RS_0);
              
                      XBYTE[0XFD7E] = (UCHAR)(tmpDat & 0xff);
                      XBYTE[0XFD7F] = (UCHAR)((tmpDat>>8) & 0xff);
                      XBYTE[0XFD80] = (UCHAR)((tmpDat>>16) & 0xff);
                      
                  DelayMs(1);
C51 COMPILER V9.00   CPU                                                                   07/02/2013 14:00:51 PAGE 6   

                      
                      #if CpuInitWrSignalMode == NORMAL_MODE_WR
                      tmpDat |=( WR_1);
                      #endif
              
                  #if CpuInitWrSignalMode == _7414_MODE_WR
                      tmpDat &=( WR_0);
                      #endif
                      
                      tmpDat |=( CS_1); 
                      tmpDat |=( RS_1); 
              
                      XBYTE[0XFD80] = (UCHAR)((tmpDat>>16) & 0xff);
                  DelayMs(1);
                  
                      printfStr("Write Cpu Pannel Cmd");
              
              }
              
              
              
              void WriteCpuData(UINT Val)
              {
                      ULONG tmpDat;
                      tmpDat = transfor18BitDate(Val);  
              
                      #if CpuInitWrSignalMode == NORMAL_MODE_WR
                      tmpDat &=( WR_0);
                      #endif
              
                  #if CpuInitWrSignalMode == _7414_MODE_WR
                      tmpDat |=( WR_1);
                      #endif
                      
                      tmpDat |=( RD_1);
                      tmpDat &=( CS_0);
                      tmpDat |=( RS_1);
              
                      XBYTE[0XFD7E] = (UCHAR)(tmpDat & 0xff);
                      XBYTE[0XFD7F] = (UCHAR)((tmpDat>>8) & 0xff);
                      XBYTE[0XFD80] = (UCHAR)((tmpDat>>16) & 0xff);
                      
                      DelayMs(1);
              
                      #if CpuInitWrSignalMode == NORMAL_MODE_WR
                      tmpDat |=( WR_1);
                      #endif
                      
                      #if CpuInitWrSignalMode == _7414_MODE_WR
                      tmpDat &=( WR_0);
                      #endif
                      
                  tmpDat |=( CS_1);
                  tmpDat |=( RS_1); 
              
                      XBYTE[0XFD80] = (UCHAR)((tmpDat>>16) & 0xff);
                  DelayMs(1);
              
                  printfStr("Write Cpu Pannel Data");
              
              }
              
C51 COMPILER V9.00   CPU                                                                   07/02/2013 14:00:51 PAGE 7   

              
              void WriteCpuSetting(UINT Cmd,UINT Val)
              {
                  WriteCpuCmd(Cmd);
                      WriteCpuData(Val);
              }
              
              
