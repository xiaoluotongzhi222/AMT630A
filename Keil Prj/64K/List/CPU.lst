              void InitalCPU_RM68130_16bit(void)
              {   
              
                      printfStr("InitalCPU_RM68130_16bit");
              
                      LCM_WR_REG(0x0028, 0x00CE); 
                  
                  LCM_WR_REG(0x0001, 0x011C);
