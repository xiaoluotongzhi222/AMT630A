                  LCM_WR_REG(0x0007, 0x0017); 
              
                  LCM_WR_REG(0x0011, 0x1000);
              
                  LCM_WR_REG(0x0020, 0x0000); 
                  LCM_WR_REG(0x0021, 0x0000); 
              
                  LCM_WR_REG(0x0036, 0x00AF);  
                  LCM_WR_REG(0x0037, 0x0000);  
                  LCM_WR_REG(0x0038, 0x00DB);  
                  LCM_WR_REG(0x0039, 0x0000);   
              
                  LCM_WR_REG(0x0002, 0x0100); 
              
                  LCM_WR_REG(0x00E8, 0x0100);
                  LCM_WR_REG(0x00B0, 0x1202);
                  LCM_WR_REG(0x000B, 0x0003); 
                  LCM_WR_REG(0x00B1, 0x0400);
              
                  LCM_WR_REG(0x0050, 0x0003); //L8   L1
                  LCM_WR_REG(0x0051, 0x0802); //L43  L20
                  LCM_WR_REG(0x0052, 0x0A0A); //L62  L55
                  LCM_WR_REG(0x0053, 0x0400);
               
                  LCM_WR_REG(0x0054, 0x0003); //L8   L1
                  LCM_WR_REG(0x0055, 0x0802); //L43  L20
                  LCM_WR_REG(0x0056, 0x0A0A); //L62  L55
                  LCM_WR_REG(0x0057, 0x0400);
              
                  LCM_WR_REG(0x0058, 0x0000);
                  LCM_WR_REG(0x0059, 0x0000);
                  
                  LCM_WR_REG(0x00E8, 0x0102);
                  LCM_WR_REG(0x00FB, 0x002A);
                  LCM_WR_REG(0x00E8, 0x0101);
                  LCM_WR_REG(0x00F1, 0x0040);
                      
                      WriteCpuCmd(0X0022);
              
