  24          #ifdef SpiInitPannelEn
              
              
              void DelaySpi(UINT DelayTime)
              {
                   while(--DelayTime);
              }
              
              
              void SetDout(UCHAR Data)
              {
              #define SPI_DELAY    0X05
              
                      UCHAR i;
                      UCHAR  tmp;
                      tmp = Data;
                      DelaySpi(20);
                      hw_setCs(0);
                      for (i = 0; i < 8; i++)
                      {
                              hw_setClk(0);  
                              if (tmp & 0x80) 
                              {
                                hw_setDout(1); 
                          }
                              else
                              {
C51 COMPILER V9.00   SPI                                                                   07/02/2013 14:00:50 PAGE 2   

                                hw_setDout(0);
                              }
                              DelaySpi(SPI_DELAY);
                              hw_setClk(1);
                              tmp <<= 1;
                              DelaySpi(SPI_DELAY);
                          
                      }
                      DelaySpi(20);   
              }
              
              
              /***************** TM035KDH08 *****************/
              #if TM035KDH08==ENABLE
              
              #define LCDCtrlRegWrite(address,data) hw_setCs(0);\
                                                       SetDout((UCHAR)(address&0xff));\
                                                       SetDout((UCHAR)(data&0xff));\
                                                       hw_setCs(1);
              
              void Pannel_SPI_Write(void)
              {
                  LCDCtrlRegWrite((0x00 << 2) | 0x03, 0x07);
                  LCDCtrlRegWrite((0x01 << 2) | 0x03, 0x00);
                  LCDCtrlRegWrite((0x02 << 2) | 0x03, 0x03);
                  LCDCtrlRegWrite((0x03 << 2) | 0x03, 0xcd);//24BIT DEN mode
                  LCDCtrlRegWrite((0x04 << 2) | 0x03, 0x46);
                  LCDCtrlRegWrite((0x05 << 2) | 0x03, 0x0d);
                  LCDCtrlRegWrite((0x06 << 2) | 0x03, 0x00);
                  LCDCtrlRegWrite((0x07 << 2) | 0x03, 0x00);
                  LCDCtrlRegWrite((0x08 << 2) | 0x03, 0x08);
                  LCDCtrlRegWrite((0x09 << 2) | 0x03, 0x40);
                  LCDCtrlRegWrite((0x0a << 2) | 0x03, 0x88);
                  LCDCtrlRegWrite((0x0b << 2) | 0x03, 0x88);
                  LCDCtrlRegWrite((0x0c << 2) | 0x03, 0x20);
                  LCDCtrlRegWrite((0x0d << 2) | 0x03, 0x20);
                  LCDCtrlRegWrite((0x0e << 2) | 0x03, 0x6B); //修改VCOM值
                  LCDCtrlRegWrite((0x0f << 2) | 0x03, 0x04);
                  LCDCtrlRegWrite((0x10 << 2) | 0x03, 0x04);
                  LCDCtrlRegWrite((0x11 << 2) | 0x03, 0x24);
                  LCDCtrlRegWrite((0x12 << 2) | 0x03, 0x24);
                  LCDCtrlRegWrite((0x1e << 2) | 0x03, 0x00);
                  LCDCtrlRegWrite((0x20 << 2) | 0x03, 0x00);
              }
              #endif
              
              
              
