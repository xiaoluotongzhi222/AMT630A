              void WriteCtrlReg(UINT RegAddr,UINT RegDat)
              {
                  LCDCtrlRegWrite(RegAddr,RegDat); 
              }
              
              void Pannel_SPI_Reset(void)
              {
                  hw_setReset(1);  
                      DelayMs(100); //note:若客户强调开机时间，此时间可以根据不同的SPI屏做相应的修改。
                      hw_setReset(0);  
                      DelayMs(100);  
                      hw_setReset(1);  
                      DelayMs(100);  
              }
              
              
              void Pannel_SPI_Initial(void)
              {  
                 printfStr("Inital Spi Pannel");
              
                 Pannel_SPI_Reset();
                 Pannel_SPI_Write();
              }
