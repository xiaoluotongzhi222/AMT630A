  15          #define _GET_USER_MSG_C_
  16          
  17          
  18          #include "DataType.h"
  19          #include "global.h"
  20          #include "MsgMap.h"
  21          #include "systemConfig.h"
  22          #include "debug.h"
  23          #include "interrupt.h"
  24          #include "GetUserInputMsg.h"
  25          #include "AdcKeyPad.h"
  26          #include "DianWeiQiKeyPad.h"
  27          #include "GPIOKeyPad.h"
  28          
  29          /***********************************************************
  30          *name:       GetKeyPadMsg(void)
  31          *input:      void
  32          *output:     void 
  33          *update:     2011-11-27 
  34          *state:      allright
  35          
  36          *description:   
  37                     获取按键板的按键值。
  38          *history:
  39                                          
  40          ************************************************************/
  41          #ifdef KeyDetectEn
              MSG POS_GetKeyPadMsg(void)
              {
                  UINT  XDATA curKeyVal = NULL_KEY;
                UCHAR curKeyCmd  = NULL_CMD;
                KeyInfor curKey = {MSG_NULL,NULL_TIME}; 
                MSG XDATA curKeyMsg;
              
              
                #if KEY_TYPE == ADC_KEY
C51 COMPILER V9.60.7.0   GETUSERINPUTMSG                                                   03/29/2026 17:21:36 PAGE 2   

                if(g_bGetUserInputFlg)
                {
                      g_bGetUserInputFlg = 0;
                  
                  //ADC按键采集到的实际的按键值
                   curKeyVal = POS_GetAdcKeyValue();
              
                  //转出宏命令
                  if(NULL_KEY != curKeyVal)
                  {
                    g_bReleaseAdcKeyFlg = FALSE;
                    curKeyCmd = POS_TransferAdcKeyCmd(curKeyVal);
                  }
                  else
                  {
                     g_bReleaseAdcKeyFlg = TRUE;
                  }
              
                  //转换为应用层的消息
                  if(NULL_CMD != curKeyCmd)
                  {   
                     curKey  = POS_TransferAdcKeyMsg(curKeyCmd); 
                  }
                }
                #endif
              
                  #if KEY_TYPE == GPIO_KEY
                if(g_bGetUserInputFlg)
                {
                    g_bGetUserInputFlg = 0;
                  
                  //GPIO按键采集到的实际的按键值
                  curKeyCmd = POS_GetGPIOKeyCmd();
              
                  if(NULL_CMD != curKeyCmd)
                  {   
                     curKey  = POS_TransferGPIOKeyMsg(curKeyCmd); 
                  }
                }
                  #endif
              
              
                #if KEY_TYPE == DIANWEIQI_KEY
                //DianWeiQi按键采集到的实际的按键值
                  curKeyVal = POS_GetDianWeiQiKeyValue();
              
                //转换为应用层的消息
                if(NULL_KEY != curKeyVal)
                {   
                    g_bReleaseAdcKeyFlg = FALSE;
                    curKey  = POS_TransferDianWeiQiKeyMsg(curKeyVal); 
                }
                else
                {
                    g_bReleaseAdcKeyFlg = TRUE;
                }
                #endif
              
                curKeyMsg = curKey.KeyMsg;
                return curKeyMsg;
              }
              #endif
