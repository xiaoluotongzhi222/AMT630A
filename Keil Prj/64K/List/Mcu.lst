 206          /***********************************************************
 207          *name:       InitialWatchdog()
 208          *input:      non
 209          *output:     
 210          *update:     2009-03-23  
 211          *state:      allright
 212          
 213          *description:   
 214                   看门狗设置
 215          *history:
 216          ************************************************************/
 217          void InitialWatchDog(void)
 218          {
 219   1          /*watchdog Setting*/ 
 220   1        WDT_UPDATE_EN = 0X55;
 221   1          MCU_CLK_REG = 0x03;      // 4分频  
 222   1          WDT_COUNTH  = 0xFF;     // 4分频  65535* 85.36us = 5.6s  
 223   1          WDT_COUNTL  = 0xFF; 
 224   1          WDT_RSTEN   = DISABLE;   // reset mcu enable
 225   1          WDT_UPDATE_EN = 0XAA;
 226   1      }
