 232          *input:      non
 233          *output:     
 234          *update:     2009-03-23  
 235          *state:      allright
 236          
C51 COMPILER V9.60.7.0   MCU                                                               03/29/2026 17:21:35 PAGE 5   

 237          *description:   
 238                   清除看门狗设置
 239          *history:
 240          ************************************************************/
 241          void POS_ClearWatchDog(void)
 242          {
 243   1          WDT_UPDATE_EN = 0X55;
 244   1          WDT_CLR    = 0xbb;            // 清WatchDog，若不清，5.6s 复位。喂狗  
 245   1          WDT_CLR    =~WDT_CLR;
 246   1          WDT_CLR    = 0x00; 
 247   1        WDT_UPDATE_EN = 0XAA;
 248   1      }
