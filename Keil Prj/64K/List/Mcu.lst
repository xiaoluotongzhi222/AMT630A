  51          ************************************************************/
  52          void InitialPPort(void)
  53          {   
  54   1          #ifdef BacklightEn
  55   1        #if BACKLIGHT_CTRL_MODE == DC_PWM0_CTRL
  56   1          SelPWM0 |= (_BIT0|_BIT1);  
  57   1          SelPWM0 &=~_BIT2; 
  58   1        #endif
  59   1      
  60   1        #if BACKLIGHT_CTRL_MODE == DC_PWM1_CTRL
                  SelPWM1 |= (_BIT4|_BIT5);  
                  SelPWM1 &=~_BIT6;
                #endif
  64   1      
  65   1        #if BACKLIGHT_CTRL_MODE == DC_PWM2_CTRL
                  SelPWM2 |= (_BIT0|_BIT1);  
                  SelPWM2 &=~_BIT2;
                #endif
  69   1      
  70   1        #if BACKLIGHT_CTRL_MODE == DC_PWM3_CTRL
                  SelPWM3 |= (_BIT4|_BIT5);  
                  SelPWM3 &=~_BIT6;
                #endif
  74   1      
  75   1        hw_clrBacklight(); 
  76   1          g_bBackLightFlg = OFF;
  77   1        hw_clrBIASEn();
  78   1          #endif
  79   1      
  80   1        #ifdef UartPrintfEn
  81   1          SetUartPrint();
  82   1          #endif
  83   1      }
