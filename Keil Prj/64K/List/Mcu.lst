 267          ************************************************************/
 268          void InitialExtInterrupt(void)
 269          {
 270   1        IP = 0X00; 
 271   1                
 272   1          /*外部中断0设置*/
 273   1          IT0 = 1;             //外部中断请求1边沿触发,此边沿触发会导致IE1 = 1.(8118 ERROR)
 274   1          IE0 = 0;             //一上电由IT0 引起 IE0 = 1
 275   1      
 276   1        /*外部中断2设置*/
 277   1        EXIF = EXIF&0xEF; //IE2 = 0
 278   1      
 279   1        /*外部中断3设置*/
 280   1        EXIF = EXIF&0xDF; //IE3 = 0
 281   1      
 282   1        /*外部中断4设置*/
 283   1        EXIF = EXIF&0xBF; //IE4 = 0
 284   1        
 285   1          /*外部中断5设置*/
 286   1        EXIF = EXIF&0x7F; //IE5 = 0
 287   1      
 288   1         /*设置外部中断2优先级*/
 289   1        PX2 =0; //若要使用外部中断2，则要置为1
 290   1      
 291   1        /*设置外部中断3优先级*/
 292   1        PX3 = 0; //若要使用外部中断3，则要置为1
 293   1        
 294   1        /*设置外部中断4优先级*/
 295   1        PX4 = 0; //若要使用外部中断4，则要置为1
 296   1      
 297   1        /*设置外部中断5优先级*/
 298   1        PX5 = 0; //若要使用外部中断5，则要置为1
C51 COMPILER V9.60.7.0   MCU                                                               03/29/2026 17:21:35 PAGE 6   

 299   1      
