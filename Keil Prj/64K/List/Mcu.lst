  87          /***********************************************************
  88          *name:      Initial805xTimer()
  89          *input:      non
  90          *output:     设置TIMER的工作方式和初值
  91          *update:     2009-03-23  
  92          *state:      allright
  93          
  94          *description:   
  95                    mcu805x 的timer 的设置
  96                1.timer 的工作方式
  97                2.timer 的初值设置
  98                3.波特率的设置
  99                4.reserve
 100          
 101          mcu 晶振频率：11.0592MHz   1/11.0592= 0.09us
 102          mcu 频率：    11.0592MHz   T3 = 256 *(1/11.0592M)  =  23us    256分频     23us 加1
 103          mcu 频率：    11.0592MHz   T4 = 1024 *(1/11.0592M) =  92us    1024分频
 104          
 105          
 106          mcu 频率：25MHz   T3 = 1024 *(1/25M) = 40.96us    256*4分频        40.96us 加1
 107          mcu 频率：25MHz   T4 = 4096 *(1/25M) = 163.84us   1024*4分频       163.84us 加1
 108          
 109          mcu 频率：24MHz   T3 = 1024 *(1/24M) = 42.66us    256*4分频        42.66us 加1
 110          mcu 频率：24MHz   T4 = 4096 *(1/24M) = 170.66us   1024*4分频       170.66us 加1
 111          
 112          *history:
C51 COMPILER V9.60.7.0   MCU                                                               03/29/2026 17:21:35 PAGE 3   

 113          ************************************************************/
 114          void InitialTimer(void)
 115          {
 116   1          /*关闭时钟*/
 117   1          TR0  = OFF;
 118   1        TR1  = OFF;
 119   1      
 120   1          /*T0 T1 模式设置*/
 121   1          TMOD = 0x11;              //定时器0方式1，16位计数 ,定时器1 方式1 16计数方式
 122   1        SetTimer0(_us(560));
 123   1        SetTimer1(_ms(5));
 124   1          SetTimer3(0);
 125   1        SetTimer4(0);
 126   1      
 127   1        /*T0 T1中断开关*/
 128   1          ET0  = OFF;           //TO中断允许
 129   1          ET1  = ON;         //T1中断允许
 130   1      
 131   1        /*定时器/计数器开关设置*/ 
 132   1          TR0  = OFF;
 133   1        TR1  = ON;
 134   1      }
 135          
 136          /***********************************************************
 137          *name:       SetT2BaudRate(Brate)
 138          *input:      Brate 波特率
 139          *output:     
 140          *update:     2009-03-23  
 141          *state:      allright
 142          
 143          *description:   
 144                   波特率的设置,注意 波特率时钟是由T2来产生。
 145          *history:
 146          ************************************************************/
 147          void SetT2BaudRate(ULONG Brate)  
 148          {
 149   1          T2CON   = 0x30;        //27MHZ  TF2,EXF2,RCLK,TCLK,EXEN2,TR2,C/T2,CP/RL2  
 150   1          SCON    = 0x50;
 151   1      
 152   1        #ifdef MCU_CLOCK_27M
 153   1        RCAP2H  = (UCHAR)(((65536-(MCU_CLK/(Brate*32)))>>8)&0xff);
 154   1        RCAP2L  = (UCHAR)((65536-(MCU_CLK/(Brate*32)))& 0xff);
 155   1        #endif
 156   1      }
 157          
 158          /***********************************************************
 159          *name:       InitialSerialPort()
 160          *input:      non
 161          *output:     
 162          *update:     2009-03-23  
 163          *state:      allright
 164          
 165          *description:   
 166                   波特率的设置,注意 波特率时钟是由T2来产生。
 167          *history:
 168          ************************************************************/
 169          void InitialSerialPort(void)
 170          {
 171   1          TR2  = OFF;
 172   1        
 173   1        SetT2BaudRate(9600); 
 174   1        TR2  = ON;  
C51 COMPILER V9.60.7.0   MCU                                                               03/29/2026 17:21:35 PAGE 4   

 175   1          ET2  = OFF;        //T2中断禁止
 176   1        TI = 0;
 177   1        RI = 0;
 178   1        
 179   1        SCON |= 0x10; 
 180   1          ES   = 0;        // Serial  interrupt disable
 181   1      }
