                    {
                        if(g_ucContBufSecond >= 60)
                        {
                            g_ucContBufSecond -= 60;
                        g_ucContNoSignalSecond++;
              
                          if(g_ucContNoSignalSecond >= NoSignalSecond)
                        {
                            return MSG_NOSIGNALPOWEROFF;
                        }
                        }
                    }
                  }
                  else
                  {
                      g_ucContNoSignalSecond = 0X00;
