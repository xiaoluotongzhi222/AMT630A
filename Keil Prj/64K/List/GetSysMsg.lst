  74          *state:      allright
  75          
  76          *description:   
  77                    获取信号状态消息。主要是检测信号有无，信号强弱等状态。
  78                    
  79          *history:
  80          
  81          ************************************************************/
  82          MSG POS_GetSignalMsg(FLAG timer)
  83          {
  84   1      #define DetecTimes   20
  85   1      
  86   1        static UCHAR XDATA ucCont = 0;
  87   1        static FLAG   bSignalFlg = FALSE;
  88   1        
  89   1        if(timer)
  90   1        {
  91   2            g_bGetSignalFlg = 0;
  92   2      
  93   2          #ifndef NoSignalBLOffEn
  94   2              //有无信号检测
  95   2          if(bSignalFlg == ((COLOR_SYS_TV_ACTIVE&_BIT1)>>1))
  96   2          {   
  97   3            if(ucCont<DetecTimes)
  98   3            {
  99   4                ucCont++; 
 100   4              if(ucCont == DetecTimes)
 101   4              {
 102   5                   if(bSignalFlg)
 103   5                   {   
 104   6                       return MSG_SIGNAL_OK; //可靠有信号
 105   6                   }
 106   5                 else
 107   5                 {   
 108   6                     return MSG_NO_SIGNAL;//无信号
 109   6                 }
 110   5              }
 111   4            }
 112   3          }
C51 COMPILER V9.60.7.0   GETSYSMSG                                                         03/29/2026 17:21:35 PAGE 3   

 113   2          else
 114   2          {
 115   3              ucCont = 0; 
 116   3              bSignalFlg = (COLOR_SYS_TV_ACTIVE&_BIT1)>>1;
 117   3          }
 118   2              #else
                  if(!IsSignalOk())
                  {
                        SelAvSOGIn();
                        SelNullChannel();
                    if(bSignalFlg == ((COMPHV_DETECT & _BIT6)>>6))
                    {
                        if(ucCont<DetecTimes)
                      {
                          ucCont++; 
                        if(ucCont == DetecTimes)
                        {
                             if(bSignalFlg)
                             {   
                                 return MSG_SIGNAL_OK; //可靠有信号
                             }
                           else
                           {   
                               return MSG_NO_SIGNAL;//无信号
                           }
                        }
                      }
                    }
                    else
                    {
                        ucCont = 0; 
                        bSignalFlg = (COMPHV_DETECT&_BIT6)>>6;
                    }
                  }
                  #endif
 148   2        }
 149   1        return MSG_NULL;
 150   1      }
