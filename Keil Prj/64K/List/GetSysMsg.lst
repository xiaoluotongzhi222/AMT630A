 207          MSG POS_GetTimeMsg(FLAG timer)
 208          {
 209   1        if(timer)
 210   1        {  
 211   2          g_bGetTimeFlg = 0;
 212   2          if(g_sysSetting.Osd.dispTime>0)
 213   2          {   
 214   3              if(--g_sysSetting.Osd.dispTime == 0)
 215   3              {    
 216   4                   /*在此判断是否需要退出OSD 还是需要显示LOGO或其他菜单*/
 217   4                       return MSG_OSD_EXIT;
 218   4              }
 219   3          }
 220   2      
 221   2            #ifdef QuickParaSaveEn 
                      if(g_sysSetting.Osd.storageTime < OSD_STORAGE_TIME)  
                      {
                    if(++g_sysSetting.Osd.storageTime == OSD_STORAGE_TIME)
                          {
                              /*在此判断是否需要快速记忆OSD数据*/
                              return(MSG_OSD_STORAGE);
                          }
                      }
                  #endif
 231   2          
 232   2          #ifdef NoSignalPowerOffEn
                  #define NoSignalSecond          2
                  if(IsPowerOn()&&!IsSignalOk())
                  {
                    if(POS_SysTimeDriver())
