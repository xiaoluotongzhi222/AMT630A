  58          /*************************************************************************
  59          name:    Abs(UINT Val1,UINT Val2)
  60          input:   Val1、Val2
  61          output:  返回当前最大的值。
  62          update： 2011-12-07
  63          state：  allright
  64          description: 返回当前最大的值。
  65          
  66          history: yshuizhou   2011/12/20   0.2    build  this  function
  67          *************************************************************************/
  68          UINT Abs(UINT Val1,UINT Val2)
  69          {
  70   1         if(Val1 >= Val2)
  71   1         {
  72   2              return (Val1-Val2);
  73   2         }
  74   1         else
  75   1         {
  76   2              return (Val2-Val1);
  77   2         }
  78   1      }
