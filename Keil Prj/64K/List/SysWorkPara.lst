  51               把这个错误的数据恢复为默认值。 
  52          *history:  
  53          *************************************************************************/
  54          void CheckSetting(void)
  55          {
  56   1        //printfStr("CheckSetting");
  57   1        if(g_sysSetting.Video.curSource >= MAX_VIDEO_CHANNEL)
  58   1        {
  59   2             g_sysSetting.Video.curSource  = INPUT_AV; 
  60   2        }
  61   1        if(g_sysSetting.Video.brigthness>MAX_VALUE)
  62   1        {
  63   2             g_sysSetting.Video.brigthness = MAX_VALUE;
  64   2        }
  65   1        if(g_sysSetting.Video.saturation>MAX_VALUE)
  66   1        {
  67   2             g_sysSetting.Video.saturation = MAX_VALUE;
  68   2        }
  69   1        if(g_sysSetting.Video.contrast>MAX_VALUE)
  70   1        {
  71   2             g_sysSetting.Video.contrast = MAX_VALUE;
  72   2        }
  73   1        if(g_sysSetting.Osd.curlanguage>MAX_LANG)
  74   1        {
  75   2           g_sysSetting.Osd.curlanguage = MIN_LAG;
  76   2        }
  77   1        if(g_sysSetting.Power.status>POWER_ON)
  78   1        {
  79   2           g_sysSetting.Power.status = POWER_ON;
  80   2        }
  81   1        if(g_sysSetting.Logo.logoID>LogoIDMax)
  82   1        {
  83   2           g_sysSetting.Logo.logoID = LogoIDMax;
  84   2        }
  85   1          if(g_sysSetting.Video.ScreeSw > MAX_VDECOLOR)
  86   1        {
  87   2          g_sysSetting.Video.ScreeSw = MAX_VDECOLOR;
  88   2        }
  89   1      }
