 324          BOOL VerifyFlashDate(ULONG stAddr)
 325          {
 326   1          UCHAR XDATA i;
 327   1        
 328   1          for(i=0;i<3;i++)
 329   1          {
 330   2          ReadFlashSysPara(stAddr, (UCHAR *)&g_sysSetting, sizeof(SysWorkParaType)); 
 331   2          if((g_sysSetting.OXAA == 0xaa) && (g_sysSetting.OX55 == 0x55))
 332   2          {
 333   3               return TRUE;
 334   3          }
 335   2          }
 336   1        return FALSE;
 337   1      }
